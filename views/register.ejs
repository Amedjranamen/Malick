<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inscription</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        primary: '#1e40af',
                        secondary: '#0f172a',
                        success: '#10b981',
                        error: '#f87171',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
        }
        .glass {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
        .input-field {
            background: #f9fafb;
            border: none;
            transition: all 0.3s ease;
        }
        .input-field:focus {
            background: #f3f4f6;
            box-shadow: 0 0 0 3px rgba(30, 64, 175, 0.1);
        }
        .btn-primary {
            background: linear-gradient(135deg, #1e40af 0%, #3b82f6 100%);
            transition: all 0.3s ease;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(30, 64, 175, 0.3);
        }
    </style>
</head>
<body class="font-sans">
<div class="min-h-screen flex items-center justify-center p-4">
    <div class="glass rounded-3xl shadow-2xl p-8 w-full max-w-lg">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">Inscription</h1>
            <p class="text-gray-600">Créez votre compte pour commencer</p>
        </div>

        <form id="registerForm" class="space-y-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nom</label>
                    <input type="text" id="nom" required
                        class="input-field w-full px-4 py-3 rounded-xl focus:outline-none"
                        placeholder="Votre nom">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                    <input type="email" id="email" required
                        class="input-field w-full px-4 py-3 rounded-xl focus:outline-none"
                        placeholder="votre@email.com">
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Nationalité</label>
                    <select id="nationalite" required
                        class="input-field w-full px-4 py-3 rounded-xl focus:outline-none">
                        <option value="">Sélectionner une nationalité</option>
                        <option value="Française">Française</option>
                        <option value="Belge">Belge</option>
                        <option value="Suisse">Suisse</option>
                        <option value="Canadienne">Canadienne</option>
                        <option value="Marocaine">Marocaine</option>
                        <option value="Algérienne">Algérienne</option>
                        <option value="Tunisienne">Tunisienne</option>
                        <option value="Sénégalaise">Sénégalaise</option>
                        <option value="Ivoirienne">Ivoirienne</option>
                        <option value="Malgache">Malgache</option>
                        <option value="Congolaise">Congolaise</option>
                        <option value="Camerounaise">Camerounaise</option>
                        <option value="Nigériane">Nigériane</option>
                        <option value="Ghanéenne">Ghanéenne</option>
                        <option value="Kényane">Kényane</option>
                        <option value="Éthiopienne">Éthiopienne</option>
                        <option value="Égyptienne">Égyptienne</option>
                        <option value="Sud-Africaine">Sud-Africaine</option>
                        <option value="Américaine">Américaine</option>
                        <option value="Britannique">Britannique</option>
                        <option value="Allemande">Allemande</option>
                        <option value="Italienne">Italienne</option>
                        <option value="Espagnole">Espagnole</option>
                        <option value="Portugaise">Portugaise</option>
                        <option value="Néerlandaise">Néerlandaise</option>
                        <option value="Autre">Autre</option>
                    </select>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Sexe</label>
                    <select id="sexe" required
                        class="input-field w-full px-4 py-3 rounded-xl focus:outline-none">
                        <option value="">Sélectionner</option>
                        <option value="homme">Homme</option>
                        <option value="femme">Femme</option>
                        <option value="autre">Autre</option>
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Diplôme</label>
                <input type="text" id="diplome" required
                    class="input-field w-full px-4 py-3 rounded-xl focus:outline-none"
                    placeholder="Ex: Master, Licence...">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Mot de passe</label>
                <input type="password" id="mot_de_passe" required
                    class="input-field w-full px-4 py-3 rounded-xl focus:outline-none"
                    placeholder="••••••••">
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Photo de profil</label>
                <div id="photoDropZone" class="border-2 border-dashed border-gray-300 rounded-xl p-6 text-center hover:border-blue-500 transition-colors cursor-pointer">
                    <svg class="w-12 h-12 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    <p class="text-gray-600 text-sm">Glissez-déposez une photo ou cliquez pour sélectionner</p>
                    <p class="text-gray-400 text-xs mt-2">Formats acceptés: JPEG, PNG, GIF, WebP (max 5MB)</p>
                    <input type="file" id="photo" accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" class="hidden">
                </div>
                <div id="photoPreview" class="hidden mt-4">
                    <img id="photoPreviewImg" src="" alt="Aperçu" class="w-24 h-24 rounded-full object-cover mx-auto border-4 border-white shadow-lg">
                    <button type="button" id="removePhoto" class="mt-2 text-red-500 text-sm hover:underline">Supprimer la photo</button>
                </div>
            </div>

            <button type="submit" 
                class="btn-primary w-full py-3 rounded-xl text-white font-semibold shadow-lg">
                S'inscrire
            </button>
        </form>

        <div class="mt-6 text-center">
            <p class="text-gray-600">
                Déjà inscrit ? 
                <a href="/login" class="text-primary font-semibold hover:underline">Se connecter</a>
            </p>
        </div>

        <div id="alert" class="hidden mt-4 p-4 rounded-xl"></div>
    </div>
</div>

<script>
// Photo upload handling
const photoDropZone = document.getElementById('photoDropZone');
const photoInput = document.getElementById('photo');
const photoPreview = document.getElementById('photoPreview');
const photoPreviewImg = document.getElementById('photoPreviewImg');
const removePhotoBtn = document.getElementById('removePhoto');

photoDropZone.addEventListener('click', () => photoInput.click());

photoDropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    photoDropZone.classList.add('border-blue-500');
});

photoDropZone.addEventListener('dragleave', () => {
    photoDropZone.classList.remove('border-blue-500');
});

photoDropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    photoDropZone.classList.remove('border-blue-500');
    const files = e.dataTransfer.files;
    if (files.length) {
        photoInput.files = files;
        handlePhotoPreview(files[0]);
    }
});

photoInput.addEventListener('change', () => {
    if (photoInput.files.length) {
        handlePhotoPreview(photoInput.files[0]);
    }
});

function handlePhotoPreview(file) {
    if (file.size > 5 * 1024 * 1024) {
        alert('La photo ne doit pas dépasser 5MB');
        photoInput.value = '';
        return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
        photoPreviewImg.src = e.target.result;
        photoPreview.classList.remove('hidden');
        photoDropZone.classList.add('hidden');
    };
    reader.readAsDataURL(file);
}

removePhotoBtn.addEventListener('click', () => {
    photoInput.value = '';
    photoPreview.classList.add('hidden');
    photoDropZone.classList.remove('hidden');
});

// Nationality autocomplete
const nationaliteSelect = document.getElementById('nationalite');
const nationalities = [
    'Française', 'Belge', 'Suisse', 'Canadienne', 'Marocaine', 'Algérienne',
    'Tunisienne', 'Sénégalaise', 'Ivoirienne', 'Malgache', 'Congolaise',
    'Camerounaise', 'Nigériane', 'Ghanéenne', 'Kényane', 'Éthiopienne',
    'Égyptienne', 'Sud-Africaine', 'Américaine', 'Britannique', 'Allemande',
    'Italienne', 'Espagnole', 'Portugaise', 'Néerlandaise', 'Autre'
];

// Form submission
document.getElementById('registerForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData();
    formData.append('nom', document.getElementById('nom').value);
    formData.append('email', document.getElementById('email').value);
    formData.append('nationalite', document.getElementById('nationalite').value);
    formData.append('sexe', document.getElementById('sexe').value);
    formData.append('diplome', document.getElementById('diplome').value);
    formData.append('mot_de_passe', document.getElementById('mot_de_passe').value);
    
    if (photoInput.files.length) {
        formData.append('photo', photoInput.files[0]);
    }

    const alert = document.getElementById('alert');

    try {
        const response = await fetch('/api/auth/register', {
            method: 'POST',
            body: formData
        });

        const data = await response.json();

        if (data.success) {
            alert.className = 'mt-4 p-4 rounded-xl bg-green-50 text-green-700 border border-green-200';
            alert.textContent = data.message;
            alert.classList.remove('hidden');
            
            // Rediriger vers la page de vérification avec l'email et le code si SMTP échoue
            setTimeout(() => {
                const redirectUrl = data.verificationCode 
                    ? `/verify?email=${encodeURIComponent(data.email)}&code=${data.verificationCode}`
                    : `/verify?email=${encodeURIComponent(data.email)}`;
                window.location.href = redirectUrl;
            }, 2000);
        } else {
            alert.className = 'mt-4 p-4 rounded-xl bg-red-50 text-red-700 border border-red-200';
            alert.textContent = data.message;
            alert.classList.remove('hidden');
        }
    } catch (error) {
        alert.className = 'mt-4 p-4 rounded-xl bg-red-50 text-red-700 border border-red-200';
        alert.textContent = 'Erreur de connexion au serveur';
        alert.classList.remove('hidden');
    }
});
</script>
</body>
</html>
